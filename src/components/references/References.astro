---
import { REFERENCES, STREAMS, REF_NOTICE } from '../../data/references';
---

<section class="section" id="references" aria-labelledby="references-h">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <p class="section-num">16 · References</p>
        <h2 id="references-h">Starting literature, honestly labeled</h2>
      </div>
      <p class="section-sub" data-reveal>
        Grouped by the four literature streams the research builds on.
      </p>
    </div>

    <div class="streams">
      {(['A', 'B', 'C', 'D'] as const).map((s) => (
        <div class="stream" data-reveal>
          <p class="mono stream__label">
            <span class="stream__code">{s}</span>
            {STREAMS[s]}
          </p>
          <ul class="stream__list">
            {REFERENCES.filter((r) => r.stream === s).map((r) => (
              <li class="stream__item">
                <span class="mono stream__id">{r.id}</span>
                <span class="stream__cite">
                  {r.authors !== '—' ? `${r.authors}, ${r.topic}` : r.topic}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <p class="ref-notice mono" data-reveal>{REF_NOTICE}</p>
  </div>
</section>

<style>
  .streams {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--grid-gap);
  }
  @media (max-width: 52rem) { .streams { grid-template-columns: 1fr; } }
  .stream {
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
    padding: var(--sp-5);
    box-shadow: var(--shadow-1);
  }
  .stream__label {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-bottom: var(--sp-4);
    color: var(--ink-2);
    font-weight: 700;
  }
  .stream__code {
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    width: 1.7rem; height: 1.7rem;
    display: grid;
    place-items: center;
    color: var(--ink);
    font-size: var(--fs-mono-sm);
  }
  .stream__list { list-style: none; padding: 0; display: grid; gap: var(--sp-2); }
  .stream__item {
    display: grid;
    grid-template-columns: 2.2rem 1fr;
    gap: var(--sp-2);
    align-items: baseline;
    font-size: var(--fs-body-sm);
    color: var(--ink-2);
  }
  .stream__id { color: var(--ink-3); font-size: var(--fs-mono-sm); }
  .stream__cite { line-height: 1.5; }

  .ref-notice {
    margin-top: var(--sp-6);
    color: var(--ink-3);
    font-size: var(--fs-mono-sm);
    max-width: var(--measure);
    line-height: 1.7;
  }
</style>