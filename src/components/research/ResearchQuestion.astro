---
import { RESEARCH, RESEARCH_QUESTIONS } from '../../data/research';
---

<section class="section" id="question" aria-labelledby="question-h">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <p class="section-num">02 · The research question</p>
        <h2 id="question-h">Does forecasting sophistication improve inventory decisions?</h2>
      </div>
      <p class="section-sub" data-reveal>
        The formal question is deliberately neutral — it asks about change, not improvement in one direction.
      </p>
    </div>

    <div class="rq-block" data-reveal>
      <p class="mono rq-block__label">Central research question</p>
      <p class="rq-block__text">{RESEARCH.question}</p>
    </div>

    <div class="tension" data-reveal>
      <h3>The tension</h3>
      <p class="lede">
        A forecast is not the end of the story. It feeds a decision, and the decision produces the business outcome.
      </p>

      <div class="tension__flow" role="img" aria-label="Diagram: forecast leads to inventory decision, which leads to cost, stockout, and service level outcomes">
        <div class="tension__node tension__node--fc">
          <span class="mono tension__node-label">Forecast</span>
          <span class="tension__node-sub">demand prediction</span>
        </div>
        <div class="tension__arrow" aria-hidden="true">→</div>
        <div class="tension__node tension__node--dec">
          <span class="mono tension__node-label">Inventory decision</span>
          <span class="tension__node-sub">what to hold, when to order</span>
        </div>
        <div class="tension__arrow" aria-hidden="true">→</div>
        <div class="tension__outcomes">
          <span class="tension__outcome inv">Cost</span>
          <span class="tension__outcome unc">Stockout</span>
          <span class="tension__outcome trad">Service level</span>
        </div>
      </div>

      <p>{RESEARCH.heroStatements.tension} {RESEARCH.heroStatements.position}</p>
    </div>

    <div class="rq-list">
      {RESEARCH_QUESTIONS.map((rq, i) => (
        <div class="rq-item" data-reveal style={`--dlay:${i * 60}ms`}>
          <span class="mono rq-item__code">{rq.code}</span>
          <p class="rq-item__q">{rq.q}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .rq-block {
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--shadow-1);
    padding: clamp(1.75rem, 4vw, 3rem);
    margin-bottom: var(--sp-8);
  }
  .rq-block__label { color: var(--ink-3); margin-bottom: var(--sp-4); }
  .rq-block__text {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.3rem);
    line-height: 1.3;
    font-weight: 500;
    letter-spacing: -0.01em;
    max-width: 30ch;
  }

  .tension { margin-bottom: var(--sp-8); }
  .tension h3 { margin-bottom: var(--sp-3); }
  .tension > p:last-of-type { color: var(--ink-2); margin-top: var(--sp-5); max-width: var(--measure); }

  .tension__flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-4);
    margin-top: var(--sp-6);
    padding: var(--sp-5);
    border: 1px dashed var(--line-2);
    border-radius: var(--r-lg);
    background: var(--surface-2);
  }
  .tension__node {
    display: grid;
    gap: 0.15rem;
    padding: var(--sp-4) var(--sp-5);
    border-radius: var(--r-md);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-1);
  }
  .tension__node-label { font-weight: 700; }
  .tension__node-sub { color: var(--ink-3); font-size: var(--fs-body-sm); }
  .tension__node--fc .mono { color: var(--c-traditional); }
  .tension__node--dec .mono { color: var(--c-inventory); }
  .tension__arrow { color: var(--ink-3); font-size: 1.3rem; }
  .tension__outcomes {
    display: flex;
    gap: var(--sp-2);
    flex-wrap: wrap;
  }
  .tension__outcome {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-sm);
    letter-spacing: var(--track-mono);
    text-transform: uppercase;
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.4rem 0.8rem;
  }

  .rq-list {
    display: grid;
    gap: var(--sp-3);
    border-top: 1px solid var(--line);
    padding-top: var(--sp-6);
  }
  .rq-item {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: var(--sp-4);
    align-items: baseline;
    padding-block: var(--sp-3);
  }
  @media (max-width: 40rem) {
    .rq-item { grid-template-columns: 1fr; gap: var(--sp-1); }
  }
  .rq-item__code { color: var(--ink-3); font-size: var(--fs-mono-sm); }
  .rq-item__q { font-weight: 500; }
</style>