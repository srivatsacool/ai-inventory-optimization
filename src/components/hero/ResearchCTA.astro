---
// The research CTA — "enter the research", not "get started".
---

<a class="cta" href="#question">
  Enter the research
  <svg width="15" height="15" viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1v12M2 8l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
</a>

<style>
  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.7rem 1.25rem;
    border-radius: var(--r-md);
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    cursor: pointer;
    text-decoration: none;
    transition: background var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }
  .cta svg {
    transition: transform 300ms var(--ease-out);
  }
  .cta:hover {
    background: var(--ink-2);
    border-color: var(--ink-2);
  }
  .cta:hover svg {
    transform: translateY(3px);
  }
  .cta:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }
</style>