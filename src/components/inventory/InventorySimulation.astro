---
import { INVENTORY_CHAIN } from '../../data/pipeline';
---

<section class="section" id="simulation" aria-labelledby="simulation-h">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <p class="section-num">08 · Inventory simulation</p>
        <h2 id="simulation-h">Forecasts become simulated operations</h2>
      </div>
      <p class="section-sub" data-reveal>
        A common policy translates every model's forecast into the same inventory mechanics — the only thing that differs between models is the forecast itself.
      </p>
    </div>

    <ol class="chain" data-reveal>
      {INVENTORY_CHAIN.map((s, i) => (
        <li class="chain__step">
          <span class="mono chain__num inv">{String(i + 1).padStart(2, '0')}</span>
          <div class="chain__body">
            <span class="mono chain__label">{s.label}</span>
            <span class="chain__detail">{s.detail}</span>
          </div>
          {i < INVENTORY_CHAIN.length - 1 && <span class="chain__arrow" aria-hidden="true">↓</span>}
        </li>
      ))}
    </ol>

    <aside class="sim-note" data-reveal>
      <p class="mono sim-note__label">Simulated, not reconstructed</p>
      <p class="sim-note__text">
        The public datasets do not provide a complete inventory ledger or the retailer's actual cost structure.
        Inventory performance here is <strong>simulated under transparent assumptions</strong> — never presented as the real
        Walmart or Favorita operation.
      </p>
    </aside>
  </div>
</section>

<style>
  .sim-note {
    margin-top: var(--sp-6);
    border: 1px solid var(--line);
    border-left: 3px solid var(--c-inventory);
    border-radius: var(--r-md);
    background: var(--surface-2);
    padding: var(--sp-5);
    max-width: var(--measure);
  }
  .sim-note__label { color: var(--c-inventory); margin-bottom: var(--sp-2); }
  .sim-note__text { color: var(--ink-2); font-size: var(--fs-body-sm); }
</style>