---
import '@fontsource-variable/inter';
import '@fontsource/spectral/400.css';
import '@fontsource/spectral/500.css';
import '@fontsource/spectral/600.css';
import '@fontsource/spectral/400-italic.css';
import '@fontsource/spectral/500-italic.css';
import '@fontsource/fragment-mono/400.css';
import '../styles/tokens.css';
import '../styles/base.css';
import SiteNav from '../components/navigation/SiteNav.astro';
import SiteFooter from '../components/navigation/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'From Traditional Forecasting to Large Language Models — Evaluating AI-Based Inventory Optimization',
  description = 'A controlled research experiment evaluating whether progressively more sophisticated demand-forecasting approaches actually produce better retail inventory outcomes.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#F4F4F1" />
  </head>
  <body>
    <!--
      ============================================================
      DIRECTION CONTRACT — "The Instrument Bench" (v0.1)
      Build: AI-INVENTORY-OPTIMIZATION research proposal website
      ============================================================
      THESIS: One experiment, honestly open — a research
      laboratory walkthrough that asks whether forecasting
      sophistication buys better inventory decisions, and
      refuses to pretend the answer is known. It refuses the
      AI-dashboard default (results nobody has) and the
      university-template default (nothing to say).
      OWN-WORLD: Cool stone paper, blue-black ink, hairline
      instrument rules on a faint grid; semantic hues carry
      meaning only — steel blue traditional, teal statistical,
      indigo neural, violet LLM, green inventory, amber
      uncertainty. Spectral editorial display + Inter body +
      Fragment Mono instrument labels. One dark laboratory
      room for the uncertainty section.
      STORY: The visitor walks the research in sequence —
      question, problem, model ladder, data, experiment,
      evaluation, inventory, LLM, uncertainty, robustness,
      practicality, roadmap, contribution, references, and a
      closing statement. They leave understanding the
      experiment and its honest openness, not a fake result.
      FIRST VIEWPORT: A quiet lab bench. The question in
      large Spectral type, the formal title beneath, and the
      eight-rung model ladder as an instrument scale —
      MA → SES → DES → TES → ARIMA → SARIMA → LSTM → LLM —
      each rung a labeled tick that animates into place.
      FORM: Single-page editorial instrument, code-led build.
      Signature interaction: the expanding model ladder.
      FINISH: unreviewed and undocumented is unfinished; this
      build ends with the finish review, the verdict, and
      DESIGN.md.
      ============================================================
    -->
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteNav />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>