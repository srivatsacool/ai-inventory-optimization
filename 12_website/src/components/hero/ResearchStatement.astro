---
// The core conceptual statement — forecast quality ≠ decision quality.
import { RESEARCH } from '../../data/research';
---

<div class="statement">
  <p class="statement__lead">{RESEARCH.heroStatements.tension}</p>
  <p class="statement__sub">{RESEARCH.heroStatements.position}</p>
</div>

<style>
  .statement { display: grid; gap: var(--sp-2); }
  .statement__lead {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
    max-width: 30ch;
    margin: 0;
  }
  .statement__sub {
    color: var(--ink-2);
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body);
    max-width: var(--measure-narrow);
    margin: 0;
    border-left: 2px solid var(--line-2);
    padding-left: var(--sp-3);
  }
</style>