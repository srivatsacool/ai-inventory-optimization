---
// Top metadata — the research stamp and provenance stack.
---

<header class="meta">
  <p class="mono meta__stamp">Research proposal · v0.1</p>
  <ul class="meta__stack mono">
    <li>SIRP / 2026</li>
    <li>Operations × AI</li>
    <li>Empirical study</li>
  </ul>
</header>

<style>
  .meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-3);
  }
  .meta__stamp {
    color: var(--ink-3);
    font-size: var(--fs-mono-sm);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    padding: 0.25rem 0.5rem;
    background: color-mix(in srgb, var(--paper) 80%, transparent);
    margin: 0;
  }
  .meta__stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-1);
    text-align: right;
    color: var(--ink-3);
    font-size: var(--fs-mono-sm);
    letter-spacing: var(--track-mono);
    text-transform: uppercase;
  }
</style>