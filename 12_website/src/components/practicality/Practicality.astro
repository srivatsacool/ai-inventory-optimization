---
import { PRACTICALITY_DIMENSIONS } from '../../data/metrics';
---

<section class="section section--alt" id="practicality" aria-labelledby="practicality-h">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <p class="section-num">13 · Practicality</p>
        <h2 id="practicality-h">The third evaluation dimension</h2>
      </div>
      <p class="section-sub" data-reveal>
        Accuracy and inventory outcomes are not the whole story. A model that wins everything but cannot be operated in practice has still lost on practicality.
      </p>
    </div>

    <div class="practicality">
      {PRACTICALITY_DIMENSIONS.map((p, i) => (
        <div class="prac" data-reveal style={`--dlay:${i * 60}ms`}>
          <p class="mono prac__label">{String(i + 1).padStart(2, '0')} · {p.label}</p>
          <p class="prac__note">{p.note}</p>
        </div>
      ))}
    </div>

    <blockquote class="prac-quote" data-reveal>
      <p>Complexity is not rewarded for being impressive. It must earn its place through what it changes — in the forecast, in the inventory outcome, or in the decision.</p>
    </blockquote>
  </div>
</section>

<style>
  .practicality {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--grid-gap);
  }
  @media (max-width: 64rem) { .practicality { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 40rem) { .practicality { grid-template-columns: 1fr; } }

  .prac {
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--surface);
    padding: var(--sp-5) var(--sp-4);
    display: grid;
    gap: var(--sp-2);
    align-content: start;
    box-shadow: var(--shadow-1);
    border-top: 2px solid var(--ink-3);
  }
  .prac__label { font-weight: 700; }
  .prac__note { color: var(--ink-3); font-size: var(--fs-body-sm); }

  .prac-quote {
    margin-top: var(--sp-7);
    max-width: var(--measure);
    border-left: 2px solid var(--ink-2);
    padding-left: var(--sp-5);
  }
  .prac-quote p {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    line-height: 1.4;
    font-weight: 500;
  }
</style>