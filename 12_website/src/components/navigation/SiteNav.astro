---
const links = [
  { href: '#question', label: 'Question' },
  { href: '#models', label: 'Models' },
  { href: '#data', label: 'Data' },
  { href: '#experiment', label: 'Experiment' },
  { href: '#evaluation', label: 'Evaluation' },
  { href: '#roadmap', label: 'Roadmap' },
  { href: '#references', label: 'References' },
];
---

<header class="nav" data-nav>
  <div class="container nav__inner">
    <a class="nav__brand" href="#top" aria-label="Back to top">
      <span class="mono nav__brand-mark">AI·INV·OPT</span>
      <span class="nav__brand-sub mono">proposal v0.1</span>
    </a>

    <nav class="nav__links" aria-label="Section navigation">
      {links.map((l) => (
        <a class="nav__link mono" href={l.href}>{l.label}</a>
      ))}
    </nav>

    <button class="nav__toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="nav-menu" aria-label="Toggle navigation menu">
      <span class="nav__toggle-bar"></span>
      <span class="nav__toggle-bar"></span>
    </button>
  </div>

  <div class="nav__menu" id="nav-menu" data-nav-menu hidden>
    <nav aria-label="Mobile section navigation">
      {links.map((l) => (
        <a class="nav__menu-link mono" href={l.href}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-fast) ease, box-shadow var(--dur-fast) ease;
  }
  .nav.is-scrolled {
    border-bottom-color: var(--line);
    box-shadow: 0 1px 0 rgba(22, 26, 34, 0.03);
  }
  .nav__inner {
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
  }
  .nav__brand {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
    text-decoration: none;
  }
  .nav__brand-mark { font-weight: 700; color: var(--ink); }
  .nav__brand-sub { color: var(--ink-3); font-size: var(--fs-mono-sm); }

  .nav__links {
    display: flex;
    gap: var(--sp-5);
  }
  .nav__link {
    text-decoration: none;
    color: var(--ink-2);
    font-size: var(--fs-mono-sm);
    padding-block: var(--sp-2);
    position: relative;
    transition: color var(--dur-fast) ease;
  }
  .nav__link::after {
    content: "";
    position: absolute;
    left: 0; right: 100%;
    bottom: 0.3rem;
    height: 1px;
    background: var(--c-traditional);
    transition: right var(--dur-med) var(--ease-out);
  }
  .nav__link:hover { color: var(--ink); }
  .nav__link.is-active { color: var(--ink); }
  .nav__link.is-active::after { right: 0; }

  .nav__toggle {
    display: none;
    background: none;
    border: 1px solid var(--line-2);
    border-radius: var(--r-sm);
    padding: 0.5rem;
    cursor: pointer;
    flex-direction: column;
    gap: 4px;
  }
  .nav__toggle-bar {
    width: 1rem;
    height: 1.5px;
    background: var(--ink);
    transition: transform var(--dur-fast) ease;
  }

  .nav__menu {
    background: var(--surface);
    border-top: 1px solid var(--line);
    padding: var(--sp-4) var(--gutter) var(--sp-5);
  }
  .nav__menu nav { display: grid; gap: var(--sp-2); max-width: var(--content-max); margin-inline: auto; }
  .nav__menu-link {
    text-decoration: none;
    color: var(--ink-2);
    font-size: var(--fs-mono-sm);
    padding-block: var(--sp-2);
    border-bottom: 1px solid var(--line);
  }
  .nav__menu-link:hover, .nav__menu-link.is-active { color: var(--ink); }

  @media (max-width: 56rem) {
    .nav__links { display: none; }
    .nav__toggle { display: inline-flex; }
    .nav__brand-sub { display: none; }
  }
</style>