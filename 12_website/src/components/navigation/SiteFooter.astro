---
import { RESEARCH } from '../../data/research';
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div>
        <p class="mono footer__label">Research proposal — v0.1</p>
        <h2 class="footer__title">{RESEARCH.title}</h2>
        <p class="footer__sub">{RESEARCH.subtitle}</p>
      </div>
      <div class="footer__meta">
        <div class="footer__meta-row"><span class="mono">Status</span><span>Conceptual freeze — no results yet</span></div>
        <div class="footer__meta-row"><span class="mono">Datasets</span><span>Walmart M5 · Corporación Favorita</span></div>
        <div class="footer__meta-row"><span class="mono">Ladder</span><span>MA → SES → DES → TES → ARIMA → SARIMA → LSTM → LLM</span></div>
        <div class="footer__meta-row"><span class="mono">Evaluation</span><span>Forecast accuracy · Inventory outcomes · Practicality</span></div>
      </div>
    </div>
    <div class="footer__bottom">
      <span class="mono">AI-INVENTORY-OPTIMIZATION · 12_website</span>
      <span class="mono">Research communication layer · proposal stage</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    background: var(--paper-2);
    padding-block: var(--sp-8) var(--sp-5);
    margin-top: var(--sp-9);
  }
  .footer__label { color: var(--ink-3); margin-bottom: var(--sp-3); }
  .footer__title { font-size: clamp(1.4rem, 2.4vw, 1.9rem); max-width: 30ch; }
  .footer__sub { color: var(--ink-2); margin-top: var(--sp-2); }
  .footer__grid {
    display: grid;
    gap: var(--sp-7);
    padding-bottom: var(--sp-7);
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 56rem) {
    .footer__grid { grid-template-columns: 1.4fr 1fr; }
  }
  .footer__meta { display: grid; gap: var(--sp-3); align-content: start; }
  .footer__meta-row {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--sp-4);
    font-size: var(--fs-body-sm);
    color: var(--ink-2);
  }
  .footer__meta-row .mono { color: var(--ink-3); font-size: var(--fs-mono-sm); }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--sp-3);
    padding-top: var(--sp-5);
    color: var(--ink-3);
    font-size: var(--fs-mono-sm);
  }
</style>