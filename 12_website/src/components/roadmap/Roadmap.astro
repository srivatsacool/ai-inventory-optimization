---
import { ROADMAP } from '../../data/roadmap';
---

<section class="section" id="roadmap" aria-labelledby="roadmap-h">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <p class="section-num">14 · Research roadmap</p>
        <h2 id="roadmap-h">Twelve phases from foundation to publication</h2>
      </div>
      <p class="section-sub" data-reveal>
        We are here: Phase 01 — Foundation. Each phase produces documented output before the next begins.
      </p>
    </div>

    <ol class="phase" data-timeline>
      {ROADMAP.map((p) => (
        <li class={`phase__item phase__item--${p.status}`} data-phase data-reveal>
          <span class="mono phase__num">{p.n}</span>
          <div class="phase__body">
            <p class="mono phase__name">{p.name}</p>
            <p class="phase__detail">{p.detail}</p>
          </div>
          <span class="mono phase__status">{p.status === 'current' ? 'now' : p.status === 'done' ? 'done' : 'next'}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .phase {
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;
    display: grid;
    gap: var(--sp-2);
  }
  .phase::before {
    content: "";
    position: absolute;
    left: 2.05rem;
    top: 0.6rem;
    bottom: 0.6rem;
    width: 1px;
    background: var(--line-2);
  }
  .phase__item {
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem 1fr auto;
    gap: var(--sp-4);
    align-items: baseline;
    padding: var(--sp-2) 0;
  }
  .phase__num {
    position: relative;
    z-index: 1;
    font-size: var(--fs-mono-sm);
    color: var(--ink-3);
    background: var(--paper);
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    display: grid;
    place-items: center;
    justify-self: center;
  }
  .phase__item--current .phase__num { background: var(--c-inventory); border-color: var(--c-inventory); color: var(--paper); }
  .phase__name { font-weight: 700; }
  .phase__item--current .phase__name { color: var(--c-inventory); }
  .phase__detail { color: var(--ink-3); font-size: var(--fs-body-sm); margin-top: 0.15rem; }
  .phase__status {
    font-size: var(--fs-mono-sm);
    color: var(--ink-3);
    text-transform: uppercase;
    letter-spacing: var(--track-mono);
  }
  .phase__item--current .phase__status { color: var(--c-inventory); }
  @media (max-width: 40rem) {
    .phase__item { grid-template-columns: 3rem 1fr; }
    .phase__status { display: none; }
  }
</style>