---
import { EXPERIMENT_PIPELINE, OPEN_PARAMETERS } from '../../data/pipeline';
---

<section class="section" id="experiment" aria-labelledby="experiment-h">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <p class="section-num">06 · Experiment design</p>
        <h2 id="experiment-h">One pipeline, followed by every model</h2>
      </div>
      <p class="section-sub" data-reveal>
        Each model receives comparable demand history, forecasts the same periods, and feeds the same inventory simulation. The pipeline animates as you scroll.
      </p>
    </div>

    <div class="pipeline" data-pipeline>
      {EXPERIMENT_PIPELINE.map((s, i) => (
        <div class="pipe-step" data-pipe-step={i} data-reveal>
          <div class="pipe-step__badge mono">{String(i + 1).padStart(2, '0')}</div>
          <div class="pipe-step__body">
            <p class="mono pipe-step__label">{s.label}</p>
            <p class="pipe-step__detail">{s.detail}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="open-block" data-reveal>
      <div class="open-block__head">
        <p class="mono open-block__label">Decisions, not gaps</p>
        <p class="open-block__sub">
          Several experimental parameters are intentionally <strong>not fixed yet</strong>. They are controlled decisions that will be finalized through EDA → literature → validation → feasibility → evidence — and each will be recorded in the decision log.
        </p>
      </div>
      <ul class="open-block__list">
        {OPEN_PARAMETERS.map((p) => (
          <li class="open-item">
            <span class="open-item__area">{p.area}</span>
            <span class="open-item__how mono">{p.howDecided}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .pipeline {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-4);
    margin-bottom: var(--sp-8);
  }
  @media (max-width: 64rem) { .pipeline { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 36rem) { .pipeline { grid-template-columns: 1fr; } }

  .pipe-step {
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--surface);
    padding: var(--sp-4);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-3);
    align-items: start;
    opacity: 0.55;
    transition: opacity var(--dur-med) ease, border-color var(--dur-med) ease, box-shadow var(--dur-med) ease, transform var(--dur-med) var(--ease-out);
  }
  .pipe-step.is-lit {
    opacity: 1;
    border-color: var(--line-2);
    box-shadow: var(--shadow-1);
    transform: translateY(-2px);
  }
  .pipe-step__badge {
    font-size: var(--fs-mono-sm);
    color: var(--paper);
    background: var(--ink-2);
    width: 1.75rem; height: 1.75rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    transition: background var(--dur-med) ease;
  }
  .pipe-step.is-lit .pipe-step__badge { background: var(--c-traditional); }
  .pipe-step__label { font-weight: 700; margin-bottom: 0.2rem; }
  .pipe-step__detail { color: var(--ink-3); font-size: var(--fs-body-sm); }
  @media (prefers-reduced-motion: reduce) {
    .pipe-step { opacity: 1; }
  }

  .open-block {
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface-2);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
  }
  .open-block__head { margin-bottom: var(--sp-5); }
  .open-block__label { color: var(--c-uncertainty); margin-bottom: var(--sp-3); }
  .open-block__sub { color: var(--ink-2); max-width: var(--measure); }
  .open-block__list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-2) var(--sp-6);
  }
  @media (max-width: 48rem) { .open-block__list { grid-template-columns: 1fr; } }
  .open-item {
    display: grid;
    gap: 0.15rem;
    padding-block: var(--sp-2);
    border-bottom: 1px solid var(--line);
  }
  .open-item__area { font-weight: 600; font-size: var(--fs-body-sm); }
  .open-item__how { color: var(--ink-3); font-size: var(--fs-mono-sm); letter-spacing: 0.02em; text-transform: none; }
</style>