---
import { FORECAST_METRICS } from '../../data/metrics';
---

<section class="section section--alt" id="evaluation" aria-labelledby="evaluation-h">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <p class="section-num">07 · Forecasting evaluation</p>
        <h2 id="evaluation-h">Forecast quality, measured fairly</h2>
      </div>
      <p class="section-sub" data-reveal>
        Candidate metrics are shown here — the final set is confirmed against the experimental structure and dataset characteristics. Nothing is pre-locked.
      </p>
    </div>

    <div class="metrics">
      {FORECAST_METRICS.map((m) => (
        <div class="metric" data-reveal>
          <p class="mono metric__code trad">{m.code}</p>
          <p class="metric__name">{m.name}</p>
          <p class="metric__note">{m.note}</p>
        </div>
      ))}
    </div>

    <p class="eval-note" data-reveal>
      <span class="mono eval-note__label">Candidate set</span>
      Final metric selection depends on the number of series, forecast horizons, and error distributions — confirmed before the comparison, recorded in the decision log.
    </p>
  </div>
</section>

<style>
  .metrics {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--grid-gap);
  }
  @media (max-width: 68rem) { .metrics { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 40rem) { .metrics { grid-template-columns: repeat(2, 1fr); } }

  .metric {
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--surface);
    padding: var(--sp-5) var(--sp-4);
    display: grid;
    gap: var(--sp-2);
    align-content: start;
    box-shadow: var(--shadow-1);
  }
  .metric__code { font-size: 1rem; font-weight: 700; }
  .metric__name { font-weight: 600; font-size: var(--fs-body-sm); }
  .metric__note { color: var(--ink-3); font-size: var(--fs-body-sm); }

  .eval-note {
    margin-top: var(--sp-6);
    max-width: var(--measure);
    color: var(--ink-2);
    font-size: var(--fs-body-sm);
  }
  .eval-note__label { display: block; color: var(--ink-3); margin-bottom: var(--sp-2); }
</style>